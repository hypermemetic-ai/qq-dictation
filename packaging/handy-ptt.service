[Unit]
Description=qq-dictation right-Control push-to-talk bridge
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/handy-ptt-bridge.py
Restart=on-failure
RestartSec=1
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
